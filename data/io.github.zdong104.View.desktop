[Desktop Entry]
Type=Application
Name=View
GenericName=Document, Image, Video and 3D Viewer
GenericName[zh_CN]=文档、图片、视频和 3D 查看器
Comment=View PDFs, images, videos, text and 3D models; sign documents with the touchpad
Comment[zh_CN]=查看 PDF、图片、视频、文本和 3D 模型；用触摸板为文档签名
Exec=view-app %U
Icon=io.github.zdong104.View
Terminal=false
StartupNotify=true
StartupWMClass=io.github.zdong104.View
Categories=Graphics;Viewer;Office;
Keywords=pdf;image;photo;video;text;code;markdown;stl;3d;dxf;cad;signature;sign;convert;
Keywords[zh_CN]=pdf;图片;照片;视频;文本;代码;markdown;stl;3d;dxf;cad;图纸;签名;转换;
MimeType=application/pdf;image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/heic;image/heif;image/avif;image/jxl;image/svg+xml;model/stl;model/x.stl-binary;model/x.stl-ascii;application/sla;model/obj;model/ply;text/csv;text/tab-separated-values;video/mp4;video/quicktime;video/webm;video/x-matroska;video/x-msvideo;text/plain;text/x-python;text/x-csrc;text/x-chdr;text/x-c++src;text/javascript;application/json;text/markdown;image/vnd.dxf;image/x-dxf;application/dxf;
Actions=new-signature;

[Desktop Action new-signature]
Name=New Signature
Name[zh_CN]=新建签名
Exec=view-app --new-signature
