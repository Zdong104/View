{
  "name": "view-chrome",
  "version": "0.1.9",
  "private": true,
  "description": "View for Chrome: a macOS-Preview-style document viewer as a Manifest V3 extension",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test/unit",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "icons": "sh scripts/icons.sh",
    "test:unit": "node scripts/unit.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.mjs\"",
    "test": "npm run typecheck && npm run licenses && npm run build && npm run test:unit && npm run test:e2e",
    "package": "node scripts/build.mjs --release && node scripts/package.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "codemirror": "^6.0.2",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "onnxruntime-web": "^1.30.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "three": "^0.186.1",
    "upng-js": "^2.1.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.14.0",
    "typescript": "^7.0.2"
  }
}
